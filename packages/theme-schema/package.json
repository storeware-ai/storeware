{
  "name": "@storeware/theme-schema",
  "version": "0.1.0",
  "description": "The Storeware theme vocabulary: the sections a shop is built from, their settings, and the parsers that read them.",
  "license": "MIT",
  "keywords": [
    "storeware",
    "theme",
    "storefront",
    "schema",
    "ecommerce"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storeware-ai/theme-schema.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./compatibility": "./src/compatibility.ts",
    "./schema.snapshot.json": "./schema.snapshot.json"
  },
  "files": [
    "dist",
    "schema.snapshot.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./compatibility": {
        "types": "./dist/compatibility.d.ts",
        "default": "./dist/compatibility.js"
      },
      "./schema.snapshot.json": "./schema.snapshot.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "snapshot": "tsx scripts/snapshot.ts",
    "snapshot:check": "tsx scripts/snapshot.ts --check"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@storeware/config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/storeware-ai/theme-schema#readme",
  "bugs": {
    "url": "https://github.com/storeware-ai/theme-schema/issues"
  }
}
